# Copy to .env and adjust. Every value has a working default, so a fresh
# checkout runs with no configuration at all.

# Leave unset to use the in-memory store (no database required).
DATABASE_URL=postgres://corrigible:corrigible@127.0.0.1:5432/corrigible_town

# Where the API listens.
CT_BIND=127.0.0.1:8787

# Directory of validated scenario files.
CT_SCENARIO_DIR=scenarios

# Write a state snapshot every N events.
CT_SNAPSHOT_EVERY=500

# Serve a built frontend from this directory (production-style single origin).
# This is what makes the app usable from a phone: one port, no CORS, no proxy.
# CT_STATIC_DIR=apps/web/dist

# Shared secret guarding the API. Leave unset on a laptop. Set it before the
# server is reachable from anywhere other than your own machine or network:
# there are no user accounts, so this is the only thing keeping strangers out.
# Clients pass it as an x-ct-access-token header or a ?k= query parameter.
# CT_ACCESS_TOKEN=

# Log filter and format.
CT_LOG=info,ct_server=debug
# CT_LOG_FORMAT=json
