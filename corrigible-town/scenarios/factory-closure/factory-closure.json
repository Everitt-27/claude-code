    {
      "id": "emergency-income-support",
      "version": 1,
      "title": "Emergency Income Support",
      "description": "A weekly payment to every resident who has lost work, paid for ten weeks from the municipal general fund, intended to keep households in their homes while the labour market absorbs the redundancies.",
      "legalAuthority": "authority.council.enact",
      "applicablePopulation": {
        "kind": "unemployedResidents"
      },
      "fundingSource": "municipalGeneralFund",
      "administrativeOwner": "institution.municipal-administration",
      "effects": [
        {
          "primitive": "transferMoney",
          "to": {
            "kind": "unemployedResidents"
          },
          "amount_per_period": 16000,
          "period_days": 7,
          "max_periods": 10
        },
        {
          "primitive": "modifyEligibility",
          "program": "emergency-income-support",
          "rule": "arrearsRequired"
        },
        {
          "primitive": "requireDisclosure",
          "subject": "weekly caseload and spend",
          "cadence_days": 14
        }
      ],
      "implementationDelayDays": 14,
      "successCriteria": [
        {
          "id": "eis.evictions",
          "description": "no more than two evictions in the ninety days after enactment",
          "metric": "evictionsSinceEnactment",
          "comparator": "atMost",
          "threshold": 2,
          "evaluateAtOffsetDays": 90
        },
        {
          "id": "eis.homelessness",
          "description": "no more than three residents left without a roof",
          "metric": "homelessResidents",
          "comparator": "atMost",
          "threshold": 3,
          "evaluateAtOffsetDays": 90
        }
      ],
      "failureCriteria": [
        {
          "id": "eis.debt",
          "description": "municipal borrowing must not exceed 120,000",
          "metric": "municipalDebtMinor",
          "comparator": "greaterThan",
          "threshold": 12000000,
          "evaluateAtOffsetDays": 90
        }
      ],
      "dataPlan": {
        "indicators": [
          "householdsInArrears",
          "evictionsSinceEnactment",
          "municipalCashMinor",
          "policySpendMinor"
        ],
        "cadenceDays": 14,
        "publication": "municipal dashboard and council minutes"
      },
      "reviewOffsetDays": 90,
      "expiration": {
        "kind": "atOffsetDays",
        "days": 120
      },
      "appealRoute": {
        "id": "appeal.municipal-appeals-panel",
        "body": "Municipal Appeals Panel",
        "deadlineDays": 30,
        "description": "A resident affected by this policy may put written grounds to the Municipal Appeals Panel within 30 days of the decision that affected them."
      },
      "profile": {
        "coerciveness": "none",
        "reversibility": "easy",
        "uncertainty": "medium",
        "durationDays": 120,
        "geographicScope": "townwide",
        "rightsImpact": "medium",
        "costConcentration": "low",
        "benefitConcentration": "medium",
        "measurableOutcomes": true,
        "estimatedFiscalCost": 9600000,
        "estimatedAffectedResidents": 66
      },
      "tradeoffNote": "Reaches households fastest and directly, but spends the general fund on transfers rather than on anything that outlasts the payments."
    },
